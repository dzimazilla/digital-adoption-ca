---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy"
  description="Privacy information for digital-adoption.ca."
  canonicalPath="/privacy/"
>
  <div class="site-container simple-page">
    <h1>Privacy</h1>
    <div class="prose">
      <p><a href="/">digital-adoption.ca</a> does not use advertising pixels, behavioural analytics, or non-essential tracking cookies.</p>
      <p>The site is delivered through <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noreferrer">Cloudflare</a>, which may process technical connection data and use strictly necessary security mechanisms to deliver and protect the site.</p>
      <p>The site uses system fonts and does not request fonts from third-party font services.</p>
    </div>
  </div>
</BaseLayout>
